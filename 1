# ====================== GitHub读写函数 ======================
def load_data_from_github():
    try:
        contents = repo.get_contents(DATA_FILE_PATH)
        raw_json = contents.decoded_content.decode("utf-8")
        d = json.loads(raw_json)
        d = migrate_data(d)
        return d, contents.sha
    except Exception as e:
        # 文件不存在，初始化空白数据
        init_data = {
            "concept_network": [],
            "life_plans": [],
            "diary": [],
            "scheme_records": [],
            "checkin": [],
            "mood_records": [],
            "self_test": [],
            "task_check": []
        }
        return init_data, None

def save_data_to_github(data, sha):
    json_str = json.dumps(data, ensure_ascii=False, indent=2)
    if sha is None:
        repo.create_file(DATA_FILE_PATH, "init mind data", json_str)
    else:
        repo.update_file(DATA_FILE_PATH, "update mind record", json_str, sha)

# ====================== 全局配置 ======================
HOUR_LIGHT = 10
HOUR_NORMAL = 18
HOUR_HIGH = 25
ENERGY_LIGHT = 6
ENERGY_NORMAL = 10
ENERGY_HIGH = 14
SIM_THRESH = 0.75
REPEAT_THRESH = 2

# ====================== 数据迁移兼容 ======================
def migrate_data(raw):
    def ensure_tags(item):
        if "tags" not in item:
            item["tags"] = []
        return item
    for k in raw:
        if isinstance(raw[k], list):
            raw[k] = [ensure_tags(x) for x in raw[k]]
    return raw

# ====================== 工具函数 ======================
def collect_all_tags(data):
    tags = set()
    for cat in data.values():
        for rec in cat:
            for t in rec.get("tags", []):
                tags.add(t.strip())
    return sorted(list(tags))

def sim_ratio(a, b):
    return SequenceMatcher(None, a, b).ratio()

def get_week_key(dt: datetime):
    return dt.strftime("%G-W%V")

def filter_records(records, search_text, selected_tags):
    out = []
    s = search_text.lower().strip()
    for r in records:
        text_buf = json.dumps(r, ensure_ascii=False).lower()
        match_search = (s == "") or (s in text_buf)
        rec_tags = r.get("tags", [])
        match_tag = (len(selected_tags) == 0) or any(t in rec_tags for t in selected_tags)
        if match_search and match_tag:
            out.append(r)
    return out

def check_high_similar_warning(new_a, new_b, link_type, network_data, repeat_thresh=REPEAT_THRESH, sim_thresh=SIM_THRESH):
    pair_new = tuple(sorted([new_a.strip(), new_b.strip()]))
    cnt = 0
    warn_msgs = []
    for rec in network_data:
        pa = rec["a"].strip()
        pb = rec["b"].strip()
        pair_old = tuple(sorted([pa, pb]))
        if pair_new == pair_old:
            cnt += 1
        if (sim_ratio(new_a, pa) > sim_thresh and sim_ratio(new_b, pb) > sim_thresh) or \
           (sim_ratio(new_a, pb) > sim_thresh and sim_ratio(new_b, pa) > sim_thresh):
            if rec["link_type"] == "文字相似":
                warn_msgs.append(f"历史近似联想：{pa} ↔ {pb}，同为文字相似，反复出现")
    trigger = False
    if link_type == "文字相似" and cnt >= repeat_thresh:
        trigger = True
        warn_msgs.append(f"⚠️ 该文字相似联想已记录 {cnt} 次，高频脑补链路，极易跳步出错，请核验！")
    return trigger, warn_msgs

# ====================== 计算模块 ======================
def calc_total_load(life_plans, new_scheme_list):
    energy_map = {"低":1, "中":2, "高":3}
    total_h = 0
    total_energy_score = 0
    for p in life_plans:
        ph = p.get("weekly_hour", 0)
        pe = p.get("energy_level", "低")
        total_h += ph
        total_energy_score += energy_map.get(pe,1)
    for s in new_scheme_list:
        sh = s.get("h",0)
        se = s.get("energy","低")
        total_h += sh
        total_energy_score += energy_map.get(se,1)
    if total_h <= HOUR_LIGHT and total_energy_score <= ENERGY_LIGHT:
        load_level = "轻松"
        tips = "✅ 负载充足，余量很大，不容易透支"
    elif total_h <= HOUR_NORMAL and total_energy_score <= ENERGY_NORMAL:
        load_level = "适中"
        tips = "🟡 负载适中，保持节奏，留意疲劳信号"
    elif total_h <= HOUR_HIGH and total_energy_score <= ENERGY_HIGH:
        load_level = "偏高"
        tips = "🟠 负载偏高！容易长期疲惫，建议砍掉次要任务或者拉长周期"
    else:
        load_level = "过载"
        tips = "🔴 严重过载！强烈不建议同时启动，极易崩盘、半途而废"
    return total_h, total_energy_score, load_level, tips

def detect_plan_conflict(solution_energy_load, solution_target, life_plans, diary_list):
    conflict_list = []
    for p in life_plans:
        conf = False
        c_msg = ""
        if p.get("confidence") != "可落地，有预案" and solution_energy_load == "高":
            conf = True
            c_msg = f"【精力冲突】规划《{p['plan_name']}》本身风险偏高，新增高精力方案容易崩盘"
        if 0.25 < sim_ratio(solution_target, p.get("expect_outcome","")) < 0.75:
            if "放弃" in p["expect_outcome"] or "减少" in p["expect_outcome"]:
                conf = True
                c_msg = f"【目标冲突】方案目标和《{p['plan_name']}》预期存在资源争夺"
        if conf:
            conflict_list.append(c_msg)
    recent_diary = diary_list[-3:] if len(diary_list)>=3 else diary_list
    for d in recent_diary:
        stuck = d.get("thinking_trap","") + d.get("confusion","")
        if sim_ratio(solution_target, stuck) > 0.4:
            conflict_list.append(f"【历史卡点预警】近期日记同类卡点：{stuck[:40]}...，可能重复踩坑")
    return conflict_list

def aggregate_history_data(data):
    week_dict = {}
    def get_week(d_str):
        try:
            return datetime.fromisoformat(d_str)
        except:
            return datetime.now()
    for p in data["life_plans"]:
        dt = get_week(p.get("create_time", datetime.now().isoformat()))
        wk = get_week_key(dt)
        if wk not in week_dict:
            week_dict[wk] = {"week_key":wk,"week_date":dt,"total_h":0,"energy_score":0,"warn_count":0,"stuck_count":0,"avg_scheme_score":0,"scheme_cnt":0,"mood_sum":0,"mood_cnt":0}
        week_dict[wk]["total_h"] += p.get("weekly_hour",0)
        e_map = {"低":1,"中":2,"高":3}
        week_dict[wk]["energy_score"] += e_map.get(p.get("energy_level","低"),1)
    for d in data["diary"]:
        dt = get_week(d.get("create_time", datetime.now().isoformat()))
        wk = get_week_key(dt)
        if wk not in week_dict:
            week_dict[wk] = {"week_key":wk,"week_date":dt,"total_h":0,"energy_score":0,"warn_count":0,"stuck_count":0,"avg_scheme_score":0,"scheme_cnt":0,"mood_sum":0,"mood_cnt":0}
        if d.get("confusion","").strip():
            week_dict[wk]["stuck_count"] +=1
        mv = d.get("mood_val",3)
        week_dict[wk]["mood_sum"] += mv
        week_dict[wk]["mood_cnt"] +=1
    for rec in data["concept_network"]:
        if rec.get("trigger_high_similar_warn",False):
            dt = get_week(rec.get("create_time", datetime.now().isoformat()))
            wk = get_week_key(dt)
            if wk not in week_dict:
                week_dict[wk] = {"week_key":wk,"week_date":dt,"total_h":0,"energy_score":0,"warn_count":0,"stuck_count":0,"avg_scheme_score":0,"scheme_cnt":0,"mood_sum":0,"mood_cnt":0}
            week_dict[wk]["warn_count"] +=1
    for sch in data["scheme_records"]:
        dt = get_week(sch.get("create_time", datetime.now().isoformat()))
        wk = get_week_key(dt)
        if wk not in week_dict:
            week_dict[wk] = {"week_key":wk,"week_date":dt,"total_h":0,"energy_score":0,"warn_count":0,"stuck_count":0,"avg_scheme_score":0,"scheme_cnt":0,"mood_sum":0,"mood_cnt":0}
        sc = (sch.get("scoreA",0)+sch.get("scoreB",0))/2
        week_dict[wk]["avg_scheme_score"] += sc
        week_dict[wk]["scheme_cnt"] +=1
    out_list = []
    for wk,item in week_dict.items():
        if item["scheme_cnt"]>0:
            item["avg_scheme_score"] = round(item["avg_scheme_score"]/item["scheme_cnt"],2)
        else:
            item["avg_scheme_score"]=0
        if item["mood_cnt"]>0:
            item["mood_score"] = round(item["mood_sum"]/item["mood_cnt"],2)
        else:
            item["mood_score"]=3
        out_list.append(item)
    out_list.sort(key=lambda x:x["week_date"])
    return out_list

# ====================== 网络图渲染 ======================
def build_pyvis_network(records):
    net = Network(
        height="700px",
        width="100%",
        bgcolor="#222222",
        font_color="white",
        filter_menu=True,
        cdn_resources="remote"
    )
    node_set = set()
    for r in records:
        a = r["a"].strip()
        b = r["b"].strip()
        link_type = r["link_type"]
        if a not in node_set:
            net.add_node(a, label=a, title=f"节点：{a}")
            node_set.add(a)
        if b not in node_set:
            net.add_node(b, label=b, title=f"节点：{b}")
            node_set.add(b)
        color = "#ff4444" if r.get("trigger_high_similar_warn") else "#44aa44"
        net.add_edge(a, b, title=f"{link_type} | {r.get('note','')}", color=color)
    return net

# ====================== 周报MD生成 ======================
def generate_weekly_md(data, week_key=None):
    if week_key is None:
        week_key = get_week_key(datetime.now())
    md = f"# 🧠 思维自检周报｜{week_key}\n\n"
    md += "## 🔗 联想记录\n"
    week_links = [x for x in data["concept_network"] if get_week_key(datetime.fromisoformat(x["create_time"])) == week_key]
    for r in week_links:
        tags = ", ".join(r.get("tags",[]))
        md += f"- {r['a']} ➜ {r['b']}【{r['link_type']}】 tags:{tags} 备注:{r.get('note','')}\n"
    md += "\n## 📋 生活规划\n"
    week_plans = [x for x in data["life_plans"] if get_week_key(datetime.fromisoformat(x["create_time"])) == week_key]
    for p in week_plans:
        tags = ", ".join(p.get("tags",[]))
        md += f"- {p['plan_name']}｜每周{p['weekly_hour']}h｜精力{p['energy_level']} tags:{tags}\n"
    md += "\n## 📔 日记 & 卡点\n"
    week_diary = [x for x in data["diary"] if get_week_key(datetime.fromisoformat(x["create_time"])) == week_key]
    for d in week_diary:
        tags = ", ".join(d.get("tags",[]))
        md += f"- 情绪:{d['mood_val']}｜卡点:{d['confusion']} tags:{tags}\n"
    md += "\n## 🛠️ 方案评估\n"
    week_scheme = [x for x in data["scheme_records"] if get_week_key(datetime.fromisoformat(x["create_time"])) == week_key]
    for s in week_scheme:
        tags = ", ".join(s.get("tags",[]))
        md += f"- 问题：{s['problem'][:60]}｜A:{s['nameA']}({s['scoreA']}) B:{s['nameB']}({s['scoreB']}) tags:{tags}\n"
    md += "\n## ✅ 打卡 & 自测\n"
    week_check = [x for x in data["checkin"] if get_week_key(datetime.fromisoformat(x["create_time"])) == week_key]
    week_test = [x for x in data["self_test"] if get_week_key(datetime.fromisoformat(x["create_time"])) == week_key]
    for c in week_check:
        tags = ", ".join(c.get("tags",[]))
        md += f"- 打卡：{c['task']} → {c['status']} tags:{tags}\n"
    for t in week_test:
        tags = ", ".join(t.get("tags",[]))
        md += f"- 自测：{t['topic']} → {t['level']} tags:{tags}\n"
    return md

