def render_m19(data, sha):
    st.header("🏷️ 全局标签管理（批量重命名 / 合并 / 删除）")
    all_tags = collect_all_tags(data)
    if not all_tags:
        st.info("暂无标签，先去录入记录添加标签")
        return
    tab_rename, tab_merge, tab_delete = st.tabs(["重命名标签", "合并标签", "删除标签"])
    with tab_rename:
        old_tag = st.selectbox("选择要修改的旧标签", all_tags)
        new_tag = st.text_input("新标签名称")
        if st.button("执行重命名") and new_tag.strip():
            cnt = 0
            for category in data.values():
                for rec in category:
                    tags = rec.get("tags", [])
                    if old_tag in tags:
                        tags.remove(old_tag)
                        tags.append(new_tag.strip())
                        rec["tags"] = list(set(tags))
                        cnt += 1
            save_data_to_github(data, sha)
            st.success(f"✅ 完成！共修改 {cnt} 条记录，`{old_tag}` → `{new_tag}`")
            st.rerun()
    with tab_merge:
        source_tags = st.multiselect("选择要合并的源标签（多选）", all_tags)
        target_tag = st.selectbox("合并到目标标签", all_tags)
        if st.button("执行合并") and source_tags:
            cnt = 0
            for category in data.values():
                for rec in category:
                    tags = rec.get("tags", [])
                    has_change = False
                    for s in source_tags:
                        if s in tags and s != target_tag:
                            tags.remove(s)
                            has_change = True
                    if has_change and target_tag not in tags:
                        tags.append(target_tag)
                        rec["tags"] = list(set(tags))
                        cnt += 1
            save_data_to_github(data, sha)
            st.success(f"✅ 合并完成，影响 {cnt} 条记录")
            st.rerun()
    with tab_delete:
        del_tag = st.selectbox("选择要删除的标签", all_tags)
        confirm = st.checkbox(f"确认永久删除标签【{del_tag}】，无法撤销")
        if confirm and st.button("删除标签"):
            cnt = 0
            for category in data.values():
                for rec in category:
                    tags = rec.get("tags", [])
                    if del_tag in tags:
                        tags.remove(del_tag)
                        rec["tags"] = tags
                        cnt += 1
            save_data_to_github(data, sha)
            st.success(f"✅ 标签已移除，共清理 {cnt} 条记录")
            st.rerun()
    st.divider()
    st.subheader("当前全部标签列表")
    st.write(all_tags)

