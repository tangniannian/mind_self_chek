def render_m01(data, sha):
    st.header("🔗 联想跳转记录")
    recs = data["concept_network"]
    st.subheader("新增联想")
    a = st.text_input("概念A")
    b = st.text_input("概念B")
    link_type = st.selectbox("关联类型", ["因果推导", "类比联想", "文字相似", "事实关联", "目标-手段"])
    note = st.text_area("备注")
    tag_input = st.text_input("标签，逗号分隔")
    tags = [x.strip() for x in tag_input.split(",") if x.strip()]
    if st.button("保存联想"):
        trigger, warn_msgs = check_high_similar_warning(a,b,link_type,data["concept_network"])
        for w in warn_msgs:
            st.warning(w)
        new_item = {
            "a":a,"b":b,"link_type":link_type,"note":note,"tags":tags,
            "trigger_high_similar_warn":trigger,
            "create_time":datetime.now().isoformat()
        }
        data["concept_network"].append(new_item)
        save_data_to_github(data, sha)
        st.success("✅ 已保存到GitHub！")
        st.rerun()
    st.divider()
    st.subheader("历史联想")
    for r in recs[-20:]:
        st.write(f"{r['a']} ↔ {r['b']} | {r['link_type']} | tags:{r.get('tags')}")
        if r.get("trigger_high_similar_warn"):
            st.warning("⚠️ 高相似预警记录")

def render_m02(data, search_text, selected_tags):
    st.header("🔗 Pyvis交互式思维网络图")
    recs = filter_records(data["concept_network"], search_text, selected_tags)
    if not recs:
        st.info("暂无联想数据")
        return
    net = build_pyvis_network(recs)
    html = net.generate_html()
    st.components.v1.html(html, height=720)

def render_m03(data, search_text, selected_tags):
    st.header("🔍 新知识关联推演")
    st.info("输入新概念，自动检索已有相似节点，辅助建立关联")
    new_node = st.text_input("新知识点")
    if st.button("查找相似节点") and new_node.strip():
        hits = []
        for r in data["concept_network"]:
            for side in [r["a"], r["b"]]:
                s = sim_ratio(new_node, side)
                if s>0.4:
                    hits.append((s, side, r))
        hits.sort(reverse=True, key=lambda x:x[0])
        if not hits:
            st.info("未找到高相似节点")
        for score, name, item in hits[:10]:
            st.write(f"匹配度{score:.2f} | {name} | {item['a']} ↔ {item['b']}")

